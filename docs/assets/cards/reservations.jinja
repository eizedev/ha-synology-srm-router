{#- Names come from the devices themselves: escape what Markdown would read as a table, link or image. -#}
{%- macro md(v) -%}{{ (v ~ '') | replace('\\', '\\\\') | replace('|', '\\|') | replace('[', '\\[') | replace(']', '\\]') | replace('!', '\\!') | replace('<', '&lt;') | replace('>', '&gt;') | replace('`', '\\`') | replace('*', '\\*') | replace('_', '\\_') }}{%- endmacro -%}
{% set s = states.sensor | selectattr('entity_id', 'in', integration_entities('synology_srm_router'))
   | selectattr('attributes.reservations', 'defined') | first %}
{% set rows = s.attributes.reservations if s else [] %}
{% set stale = rows | selectattr('stale') | list %}
**{{ rows | count }} reservations** · {{ rows | selectattr('online') | list | count }} of their devices online

{% if stale -%}
Not online, and not seen by Home Assistant in the last 30 days: candidates to remove.

| Device | IP | Last seen |
|---|---|---|
{% for r in stale -%}
| {{ md(r.name or r.mac) }} | {{ md(r.ip) }} | {{ r.last_seen or 'not since Home Assistant tracks' }} |
{% endfor %}
{%- else -%}
Every reserved device was seen in the last 30 days.
{%- endif %}
