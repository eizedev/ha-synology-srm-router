{#- Names come from the devices themselves: escape what Markdown would read as a table, link or image. -#}
{%- macro md(v) -%}{{ (v ~ '') | replace('\r', ' ') | replace('\n', ' ') | replace('\\', '\\\\') | replace('|', '\\|') | replace('[', '\\[') | replace(']', '\\]') | replace('!', '\\!') | replace('<', '&lt;') | replace('>', '&gt;') | replace('`', '\\`') | replace('*', '\\*') | replace('_', '\\_') }}{%- endmacro -%}
{% set s = states.sensor | selectattr('entity_id', 'in', integration_entities('synology_srm_router'))
   | selectattr('attributes.leases', 'defined') | first %}
{% set rows = (s.attributes.leases if s else []) | selectattr('unknown') | list %}
{% if rows %}
Devices with an address but neither a reservation nor a name given in SRM:

{% for r in rows -%}
- {{ '●' if r.online else '○' }} **{{ md(r.name or 'no name') }}** · {{ md(r.ip) }} · `{{ md(r.mac) }}`
{% endfor %}
Give the ones you know a name in SRM; the rest are worth a look.
{% else %}
Every device with an address is reserved or named in SRM.
{% endif %}
